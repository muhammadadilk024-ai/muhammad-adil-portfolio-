# muhammadadil.cloud: one canonical host, clean URLs, caching
RewriteEngine On

# www -> apex
RewriteCond %{HTTP_HOST} ^www\.muhammadadil\.cloud$ [NC]
RewriteRule ^(.*)$ https://muhammadadil.cloud/$1 [R=301,L]

# http -> https is handled by the Hostinger CDN, so there is no origin rule for it (avoids redirect loops)

# /folder/index.html -> /folder/
RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|webp|jpg|png|svg|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
